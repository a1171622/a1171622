    LET#N #GL(#K)
    COPY NO #N FACT #GSUP
  ENDLOOP
  LOOP#K QL
    LET#N #QL(#K)
    COPY NO #N FACT #GQ
  ENDLOOP
  LOOP#K HL
    LET#N #HL(#K)
    COPY NO #N FACT #FHW
  ENDLOOP
  COPY NO 21 FACT #GQW
  COPY NO 25 FACT #GQW
  IF #EHF>0
    COPY NO 501 FACT #GSUP
    COPY NO 505 FACT #GQ
  ENDIF
