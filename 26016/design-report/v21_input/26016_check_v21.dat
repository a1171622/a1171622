$ ======================== temperature ========================
LC 91 TYPE 'T' TITL 'T uniform expansion'
  BEAM FROM GRP TO 11 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 12 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 13 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 14 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 15 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 21 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 23 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 24 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 25 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 31 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 35 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 60 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 61 TYPE DT PA #DTP PE #DTP
  BEAM FROM GRP TO 62 TYPE DT PA #DTP PE #DTP
  IF #TSH>0
    QUAD FROM GRP TO 1 TYPE DTXY P #DTP
    QUAD FROM GRP TO 2 TYPE DTXY P #DTP
    QUAD FROM GRP TO 6 TYPE DTXY P #DTP
    QUAD FROM GRP TO 7 TYPE DTXY P #DTP
  ENDIF

LC 92 TYPE 'T' TITL 'T uniform contraction'
  BEAM FROM GRP TO 11 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 12 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 13 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 14 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 15 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 21 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 23 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 24 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 25 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 31 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 35 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 60 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 61 TYPE DT PA #DTN PE #DTN
  BEAM FROM GRP TO 62 TYPE DT PA #DTN PE #DTN
  IF #TSH>0
    QUAD FROM GRP TO 1 TYPE DTXY P #DTN
    QUAD FROM GRP TO 2 TYPE DTXY P #DTN
    QUAD FROM GRP TO 6 TYPE DTXY P #DTN
    QUAD FROM GRP TO 7 TYPE DTXY P #DTN
  ENDIF

$ ======================== equivalent horizontal forces: phi x vertical loads. 501-504 permanent part, 505-508 imposed part, 509-512 design level for MAXIMA ========================
LC 501 TYPE '-' TITL 'EHF G +X'
