$ ULS eq 6.10 (STR/GEO set B) and EQU set A; SLS characteristic eq 6.14b. FACD = factor on self-weight.
$ EHF (#EHF 1) is added in the wind direction, and in each direction for 141-148, with the same factors as G and Q.

LC 101 TYPE '(D)' FACD #GSUP TITL '101 ULS 1.35G'
  LOOP#K GL
    LET#N #GL(#K)
    COPY NO #N FACT #GSUP
  ENDLOOP
LC 102 TYPE '(D)' FACD #GSUP TITL '102 ULS 1.35G+1.5Q'
  LOOP#K GL
    LET#N #GL(#K)
    COPY NO #N FACT #GSUP
  ENDLOOP
  LOOP#K QL
    LET#N #QL(#K)
    COPY NO #N FACT #GQ
  ENDLOOP
  LOOP#K HL
    LET#N #HL(#K)
    COPY NO #N FACT #FH
  ENDLOOP
LC 103 TYPE '(D)' FACD #GSUP TITL '103 ULS G+Q+psiW +X uplift'
