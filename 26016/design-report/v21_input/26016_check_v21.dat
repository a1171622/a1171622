-PROG BDK urs:9002     $ switch on with +PROG once the governing members are known, edit the LC list and the members
HEAD 26016 buckling detail: full tables (Mcr, C1, lambda_LT, chi_LT, chi_y, chi_z, k-factors) for selected members
ECHO FULL NO
ECHO FORC YES
ECHO SECT YES
ECHO BOUN YES
ECHO EIGE YES
ECHO MEMB FULL
ECHO SUM EXTR
ECHO PLOT YES
$ the switches #DXR #EZR #AUTO #DECK #DECKR #NPART #SWAY #COLD are read from the database as the first program stored them
TVAR NAME GAM-S1 VAL 1.0 SCOP DESI
CTRL OPT EN SCL AUTO CURV C MTHD 2 BETA 0.75 LLT0 0.4 TAB NO LTB AUTO SWY NO SWZ NO LCST 0
LC 102,107,116,128,145      $ edit: the governing combinations from the summary table of the first run
$ L2 radial 0 deg: SLN 73, L 11.34 m, stations: r 3.0 at 9.00 m (ring beams only), r 8.5 at 3.50 m (ring beams only)   (copy any member block from the first program here)
$   spans between the ring crossings: 3.50 / 5.50 / 2.34 m, longest 5.50 m: SKY 0.485 on the MEMB record if Ncr,y is to be taken on that span (see header)
IF #AUTO>0
  CVA CB 0 CY AUTO CZ AUTO DX AUTO DY AUTO DZ AUTO
  CVE CB 0 CY AUTO CZ AUTO DX AUTO DY AUTO DZ AUTO
ELSE
  CVA CB 0 CY FIX CZ FIX DX FIX DY 0 DZ 0            $ fork support
  CVE CB 0 CY FIX CZ FIX DX FIX DY 0 DZ 0
ENDIF
CVL REF STRT S 9.000 CY FIX DX #DXR EZ #EZR          $ r 3.0: ring beams only
CVL REF STRT S 3.500 CY FIX DX #DXR EZ #EZR          $ r 8.5: ring beams only
IF #DECK>0
  CVL HDIV #NPART CY FIX EZ TOP                       $ top-flange lateral restraint by the deck
ENDIF
MEMB SLN 73 TYPE LTB ID 73
CTRL OPT EN SCL AUTO CURV B MTHD 2 BETA 0.75 LLT0 0.4 TAB NO LTB AUTO SWY NO SWZ NO LCST 0
LC 102,107,116,128,145      $ edit: the governing combinations from the summary table of the first run
$ roof radial 0 deg: SLN 275 + 286 + 287, L 11.34 m, stations: r 3.0 at 9.00 m (ring beams only), r 8.5 at 3.50 m (ring beams only)   (copy any member block from the first program here)
$   spans between the ring crossings: 3.50 / 5.50 / 2.34 m, longest 5.50 m: SKY 0.485 on the MEMB record if Ncr,y is to be taken on that span (see header)
IF #AUTO>0
  CVA CB 0 CY AUTO CZ AUTO DX AUTO DY AUTO DZ AUTO
  CVE CB 0 CY AUTO CZ AUTO DX AUTO DY AUTO DZ AUTO
ELSE
  CVA CB 0 CY FIX CZ FIX DX FIX DY 0 DZ 0            $ fork support
  CVE CB 0 CY FIX CZ FIX DX FIX DY 0 DZ 0
ENDIF
CVL REF STRT S 9.000 CY FIX DX #DXR EZ #EZR          $ r 3.0: ring beams only
CVL REF STRT S 3.500 CY FIX DX #DXR EZ #EZR          $ r 8.5: ring beams only
IF #DECKR>0
  CVL HDIV #NPART CY FIX EZ TOP                       $ top-flange lateral restraint by the deck
ENDIF
MEMB SLN 275 TYPE LTB ID 275
     CONT 286
     CONT 287
CTRL OPT EN SCL AUTO CURV B MTHD 2 BETA 0.75 LLT0 0.4 TAB NO LTB AUTO SWY NO SWZ NO LCST 0
LC 102,107,116,128,145      $ edit: the governing combinations from the summary table of the first run
$ L1 radial 0 deg: SLN 169 + 180 + 181, L 10.10 m, stations: r 3.0 at 9.00 m (ring beams only), r 8.5 at 3.50 m (column 38)   (copy any member block from the first program here)
$   spans between the ring crossings: 3.50 / 5.50 / 1.10 m, longest 5.50 m: SKY 0.545 on the MEMB record if Ncr,y is to be taken on that span (see header)
IF #AUTO>0
  CVA CB 0 CY AUTO CZ AUTO DX AUTO DY AUTO DZ AUTO
  CVE CB 0 CY AUTO CZ AUTO DX AUTO DY AUTO DZ AUTO
ELSE
  CVA CB 0 CY FIX CZ FIX DX FIX DY 0 DZ 0            $ fork support
  CVE CB 0 CY FIX CZ FIX DX FIX DY 0 DZ 0
ENDIF
CVL REF STRT S 9.000 CY FIX DX #DXR EZ #EZR          $ r 3.0: ring beams only
CVL REF STRT S 3.500 CY FIX DX FIX  EZ #EZR          $ r 8.5: column 38
IF #DECK>0
  CVL HDIV #NPART CY FIX EZ TOP                       $ top-flange lateral restraint by the deck
ENDIF
MEMB SLN 169 TYPE LTB ID 169
     CONT 180
     CONT 181
CTRL OPT EN SCL AUTO CURV C MTHD 2 BETA 0.75 LLT0 0.4 TAB NO LTB AUTO SWY NO SWZ NO LCST 0
LC 102,107,116,128,145      $ edit: the governing combinations from the summary table of the first run
$ L2 ring r 12.0 at 20 deg: SLN 55, L 4.17 m   (v11: UB 254 -> use CURV B for this member)
IF #AUTO>0
  CVA CB 0 CY AUTO CZ AUTO DX AUTO DY AUTO DZ AUTO
  CVE CB 0 CY AUTO CZ AUTO DX AUTO DY AUTO DZ AUTO
ELSE
  CVA CB 0 CY FIX CZ FIX DX FIX DY 0 DZ 0            $ fork support
  CVE CB 0 CY FIX CZ FIX DX FIX DY 0 DZ 0
ENDIF
IF #DECK>0
  CVL HDIV #NPART CY FIX EZ TOP                       $ top-flange lateral restraint by the deck
ENDIF
MEMB SLN 55 TYPE LTB ID 55
IF #COLD>0
  IF #SWAY>0
  CTRL OPT EN SCL AUTO CURV C MTHD 2 BETA 0.75 LLT0 0.4 TAB NO LTB AUTO SWY YES SWZ YES LCST 0
  ELSE
  CTRL OPT EN SCL AUTO CURV C MTHD 2 BETA 0.75 LLT0 0.4 TAB NO LTB AUTO SWY NO SWZ NO LCST 0
  ENDIF
ELSE
  IF #SWAY>0
  CTRL OPT EN SCL AUTO CURV B MTHD 2 BETA 0.75 LLT0 0.4 TAB NO LTB AUTO SWY YES SWZ YES LCST 0
  ELSE
  CTRL OPT EN SCL AUTO CURV B MTHD 2 BETA 0.75 LLT0 0.4 TAB NO LTB AUTO SWY NO SWZ NO LCST 0
  ENDIF
ENDIF
LC 102,107,116,128,145      $ edit: the governing combinations from the summary table of the first run
$ group 11 SLN 19: V-column raker, ground to L1, RHS 150x150x10, L 5.81 m, z 0.00 -> 4.05, 44 deg to the horizontal, fork ends, Lcr = L
IF #AUTO>0
  CVA CB 0 CY AUTO CZ AUTO DX AUTO DY AUTO DZ AUTO
