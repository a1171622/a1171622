$ mini model for the tool tests (synthetic, not a SOFiSTiK export)
+PROG AQUA
HEAD mini
STEE 3 S '275' TITL "=S 275"
SECT 2 MNO 3
PROF TYPE 'UB' Z1 254 Z2 146 Z3 43 MNO 3
END
+PROG SOFIMSHC
SLN 10 GRP 1 SNO 2 TITL "Line"
SLN 11 GRP 1 SNO 2 TITL "Line"
SLN 12 GRP 1 SNO 2 TITL "Line"
SLN 13 GRP 2 TITL "no section"
END
+PROG SOFILOAD
HEAD loads
STO#SDL 2.5
STO#GQ 1.5
STO#PSI 0.6
STO#LCS 2,3
STO#FL 1.35,1.5
LC 1 TYPE 'G' FACD 1 TITL 'self weight'
LC 2 TYPE 'G' TITL 'SDL'
  BEAM GRP 1 TYPE PG #SDL
LC 3 TYPE 'Q' TITL 'live'
  BEAM GRP 1 TYPE PG #GQ
LC 101 TYPE '(D)' FACD 1.35 TITL 'ULS 1'
  COPY NO 2 FACT 1.35
  COPY NO 3 FACT #GQ
LC 102 TYPE '(D)' FACD 1.35 TITL 'ULS 2'
  LOOP#K 2
    LET#N #LCS(#K)
    LET#F #FL(#K)
    COPY NO #N FACT #F
  ENDLOOP
END
+PROG BDK
HEAD members
CTRL OPT EN LCST 9100
LC 101,102
MEMB SLN 10 TYPE LTB ID 10
     CONT 11
END
